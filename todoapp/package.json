{
  "name": "simple-todoapp",
  "version": "1.0.0",
  "description": "A simple todo app built with vanilla JavaScript",
  "main": "index.html",
  "scripts": {
    "start": "python3 -m http.server 8000",
    "dev": "python3 -m http.server 8000",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": ["todo", "javascript", "vanilla-js"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@jest/environment-jsdom": "^29.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "dependencies": {},
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": ["<rootDir>/tests/setup.js"],
    "collectCoverageFrom": [
      "**/script.js",
      "!tests/**",
      "!node_modules/**",
      "!coverage/**"
    ],
    "coverageReporters": ["text", "lcov", "html"],
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  }
}