{
  "permissions": {
    "allow": [
      "Bash(python:*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "AutoEdit(*)"
    ],
    "deny": [
      "Write(.env*)",
      "Write(settings*.json)"
    ]
  },
  "claude": {
    "model": "glm-4.6",
    "maxTokens": 16384,
    "temperature": 0.7,
    "enablePlanMode": true,
    "autoApproveEdits": true,
    "autoApproveWrites": true,
    "autoApproveCreates": true,
    "interactiveMode": false,
    "confirmBeforeEdit": false,
    "alwaysYes": true
  },
  "todoapp": {
    "development": {
      "port": 8000,
      "host": "localhost",
      "autoOpen": true
    },
    "features": {
      "maxTodoLength": 200,
      "enableTimestamps": true,
      "enablePersistence": true,
      "autoSave": true,
      "enableEdit": true,
      "enablePriority": true,
      "enableDarkMode": true,
      "enableAnimations": true,
      "enableKeyboardShortcuts": true
    },
    "ui": {
      "theme": "light",
      "animations": true,
      "confirmDeleteAll": true,
      "showCompletedCount": true,
      "enableDragDrop": false
    }
  },
  "storage": {
    "localStorageKey": "todos",
    "enableBackup": false,
    "backupInterval": 300000,
    "maxStorageSize": "5MB"
  },
  "development": {
    "enableDebugMode": false,
    "logLevel": "info",
    "enableHotReload": false,
    "showPerformanceMetrics": false
  },
  "security": {
    "enableXSSProtection": true,
    "maxInputLength": 500,
    "sanitizeHTML": true
  },
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp"]
    }
  }
}